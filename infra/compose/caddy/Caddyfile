# EasySynQ edge: TLS termination, static SPA, /api routing, security headers.
# SITE_ADDRESS defaults to :80 (plain HTTP) for the dev skeleton; in production set
# it to your domain for automatic TLS, or use the internal issuer when air-gapped.
{
	admin off

	# Measured against caddy:2 (v2.11.4): by DEFAULT Caddy REPLACES X-Forwarded-For with the single
	# address it observed, discarding whatever the caller sent — which is why a client cannot forge
	# the address the API attributes a request to. It only APPENDS, preserving an upstream chain,
	# for a peer named here. Empty by default: with Caddy as the outermost proxy, replacing is the
	# stronger behaviour and there is no upstream chain worth keeping.
	#
	# Set this ONLY when a further load balancer sits in front of Caddy, and name ONLY that load
	# balancer, e.g. CADDY_TRUSTED_PROXIES='trusted_proxies static 203.0.113.0/24'. Naming a broad
	# range here re-opens forgery: any caller inside it would have its own X-Forwarded-For
	# preserved and passed on. The API side needs the matching entry in TRUSTED_PROXY_CIDRS — both
	# halves are required, because Caddy decides what reaches the API and the API decides what it
	# believes.
	servers {
		{$CADDY_TRUSTED_PROXIES}
	}
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	# TLS: Caddy enforces a TLS 1.2 floor + modern AEAD-only ciphers BY DEFAULT (doc 12 §6.1 / doc 03
	# §8) — no explicit policy is set here, because a `tls` connection-policy block is INVALID on the
	# plain-HTTP dev :80 listener (Caddy refuses to adapt it). Production sets SITE_ADDRESS to a domain
	# for automatic HTTPS (ACME). When ACME is unreachable (air-gap), the overlay sets
	# CADDY_TLS_DIRECTIVE="tls internal" (Caddy's self-signed internal CA) — set SITE_ADDRESS to a
	# hostname for it to take effect. Empty by default → no-op on :80.
	{$CADDY_TLS_DIRECTIVE}

	# Site-wide response headers safe on every route (doc 12 §6.1).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	# Default-off rollback guard. During an incompatible application rollback, stop only mutating
	# API requests before any more-specific proxy handle can claim them; reads and non-API routes
	# continue normally.
	@compatibility_rollback_write {
		path /api/*
		method POST PUT PATCH DELETE
		vars {env.EASYSYNQ_COMPATIBILITY_READ_ONLY} 1
	}
	handle @compatibility_rollback_write {
		respond "Write operations are disabled during compatibility rollback." 503
	}

	# The notification SSE stream needs immediate flushing (no response buffering) for a long-lived
	# connection — its own reverse_proxy with flush_interval -1 (doc 10 §9, S-notify-5c). MUST precede
	# @api (handle is first-match-wins; this path is a subset of /api/*).
	@sse path /api/v1/notifications/stream
	handle @sse {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	# The two unauthenticated API-served HTML pages sit outside the SPA handle, so they need their
	# own document policy. They contain inline style attributes but no scripts, forms, embeds, or
	# external assets. The bearer tokens stay out of referrers, and both CSP + the legacy frame
	# header deny clickjacking.
	@public_html path /api/v1/verify /api/v1/evidence-packs/shared
	handle @public_html {
		header {
			Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
			X-Frame-Options "DENY"
			Referrer-Policy "no-referrer"
		}
		reverse_proxy api:8000
	}

	# API surface and health probes go to the FastAPI service.
	@api path /api/* /healthz /readyz
	handle @api {
		reverse_proxy api:8000
	}

	# Keycloak is reached by the browser through the proxy (so its issuer is the
	# host-facing http://localhost) while the API validates tokens against it on the
	# internal network. Caddy forwards X-Forwarded-* so Keycloak derives the right host.
	@keycloak path /realms/* /resources/*
	handle @keycloak {
		reverse_proxy keycloak:8080
	}

	# Everything else is the SPA. The strict static Content-Security-Policy is scoped HERE (not
	# global) so it never breaks the Keycloak admin console / login theme on the @keycloak routes
	# (Keycloak serves its own assets + sets its own CSP). `script-src 'self'` has NO inline/eval
	# escape (the Vite build emits no inline scripts); the OIDC redirect is a top-level, same-origin
	# (through Caddy) navigation. `connect-src` is 'self' PLUS {$S3_PUBLIC_ENDPOINT} because the browser
	# uploads/downloads controlled bytes DIRECTLY to the object store via presigned URLs (a different
	# origin than the app, e.g. http://localhost:9000 in dev) — 'self' alone would block those (the
	# S-web-5 browser-upload finding). Production sets the dedicated https://host:9443 MinIO origin.
	# `style-src` allows 'unsafe-inline'
	# ONLY for styles (never script) because Mantine injects runtime inline <style> for its theme — a
	# strict style nonce needs SPA build/HTML nonce injection this static proxy can't do (a web-track
	# v1 refinement, like a full per-request script nonce-CSP).
	handle {
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' {$S3_PUBLIC_ENDPOINT}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; frame-src 'none'; upgrade-insecure-requests"
		reverse_proxy web:5173
	}
}
