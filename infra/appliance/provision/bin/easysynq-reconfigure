#!/usr/bin/env bash
# Re-point the appliance at a real DNS name (e.g. an AD A-record) instead of mDNS easysynq.local.
#
#   easysynq-reconfigure --host easysynq.corp.example.com
#
# Rewrites every browser-facing URL in .env (site, MinIO presign host, QR/share/deep-link bases,
# Keycloak hostname and OIDC issuer), adds the new redirect URIs to the Keycloak web client, and
# recreates the affected containers. The issuer
# change means everyone signs in again (tokens from the old issuer stop validating) — run this
# before real usage starts, not after.
set -euo pipefail
[ "$(id -u)" -eq 0 ] || { echo "run with sudo" >&2; exit 1; }

HOST=""
while [ $# -gt 0 ]; do
  case "$1" in
    --host) HOST="$2"; shift 2 ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done
[ -n "$HOST" ] || { echo "usage: easysynq-reconfigure --host <fqdn>" >&2; exit 2; }
if ! bash /opt/easysynq/scripts/validate-dns-name.sh "$HOST"; then
  echo "easysynq-reconfigure: --host must be a valid DNS name without a scheme, path, or port" >&2
  exit 2
fi

ENV=/opt/easysynq/.env
set_kv() {
  if grep -qE "^$1=" "$ENV"; then sed -i "s|^$1=.*|$1=$2|" "$ENV"; else printf '%s=%s\n' "$1" "$2" >>"$ENV"; fi
}

set_kv SITE_ADDRESS "https://${HOST}"
set_kv MINIO_SITE_ADDRESS "https://${HOST}:9443"
set_kv S3_PUBLIC_ENDPOINT "https://${HOST}:9443"
set_kv PUBLIC_BASE_URL "https://${HOST}"
set_kv APP_BASE_URL "https://${HOST}"
set_kv KEYCLOAK_HOSTNAME "https://${HOST}"
set_kv OIDC_ISSUER "https://${HOST}/realms/easysynq"
bash /opt/easysynq/scripts/validate-browser-origins.sh --env-file "$ENV"

# Append the new callback to the complete client representation. This preserves callbacks an
# operator or identity-provider integration added before the hostname change.
easysynq-compose exec -T api uv run python -m easysynq_api.cli.keycloak_redirect \
  --redirect-uri "https://${HOST}/*" </dev/null

echo "recreating the browser-facing services with the new host..."
easysynq-compose up -d keycloak proxy api worker beat

echo "done — the app now lives at https://${HOST}"
echo "Reminder: create the DNS A record for ${HOST}, and distribute the Caddy internal CA"
echo "(easysynq-status shows readiness; the runbook's GPO section covers the CA rollout)."
