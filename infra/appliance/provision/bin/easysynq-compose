#!/usr/bin/env bash
# docker compose with the appliance's full overlay set — the ONE compose invocation every helper
# and operator command must use (base + S profile + internal-TLS + production MinIO site).
set -euo pipefail
APP_DIR="${EASYSYNQ_APP_DIR:-/opt/easysynq}"
MIGRATION_SCRIPT="${EASYSYNQ_MIGRATION_SCRIPT:-scripts/migrate-keycloak-h2.sh}"
cd "$APP_DIR"

# Compatibility for an appliance .env generated before Batch 13: the old provisioner already wrote
# SITE_ADDRESS but omitted these three same-origin consumers. Export derived values for this Compose
# process without weakening the 0640 env-file permissions; reconfigure/new provisioning persists them.
env_value() {
  grep -m1 "^$1=" .env 2>/dev/null | cut -d= -f2- \
    | sed -E 's/[[:space:]]+#.*$//; s/^[[:space:]]*//; s/[[:space:]]*$//' || true
}
SITE_VALUE="$(env_value SITE_ADDRESS)"
[ -n "$SITE_VALUE" ] || SITE_VALUE="https://easysynq.local"
for key in PUBLIC_BASE_URL APP_BASE_URL KEYCLOAK_HOSTNAME; do
  if [ -z "$(env_value "$key")" ]; then
    export "${key}=${SITE_VALUE}"
  fi
done

# The first full (or Keycloak-targeted) `up` after upgrading from the legacy start-dev/H2 service
# must export identities before Compose recreates Keycloak. A non-Keycloak service target leaves
# that legacy container untouched, so do not stop it and take authentication offline.
up_needs_keycloak_migration() {
  local saw_up=0 skip_value=0 ambiguous=0 arg target
  local -a targets=()

  for arg in "$@"; do
    if [ "$saw_up" -eq 0 ]; then
      if [ "$arg" = "up" ]; then
        saw_up=1
      fi
      continue
    fi
    if [ "$skip_value" -eq 1 ]; then
      skip_value=0
      continue
    fi
    case "$arg" in
      --attach|--exit-code-from|--no-attach|--pull|--scale|-t|--timeout|--wait-timeout)
        skip_value=1
        ;;
      --*=*|-t?*)
        ;;
      --abort-on-container-exit|--abort-on-container-failure|--always-recreate-deps|\
      --attach-dependencies|--build|-d|--detach|--force-recreate|--menu|--no-build|\
      --no-color|--no-deps|--no-log-prefix|--no-recreate|--no-start|--quiet-pull|\
      --remove-orphans|--renew-anon-volumes|--timestamps|--wait|--watch|-y|--yes)
        ;;
      --)
        ;;
      -*)
        # A future option may consume the next token. Prefer the migration fail-safe over guessing
        # that token is a service name and risking an H2 container recreation without an export.
        ambiguous=1
        ;;
      *)
        targets+=("$arg")
        ;;
    esac
  done

  [ "$saw_up" -eq 1 ] || return 1
  [ "$skip_value" -eq 0 ] || return 1
  [ "$ambiguous" -eq 0 ] || return 0
  [ "${#targets[@]}" -gt 0 ] || return 0
  for target in "${targets[@]}"; do
    [ "$target" = "keycloak" ] && return 0
  done
  return 1
}

if up_needs_keycloak_migration "$@"; then
  bash "$MIGRATION_SCRIPT" --env-file .env
fi

exec docker compose --env-file .env \
  -f infra/compose/compose.yml \
  -f infra/compose/compose.s.yml \
  -f infra/compose/compose.airgap.yml \
  -f infra/compose/compose.production.yml "$@"
