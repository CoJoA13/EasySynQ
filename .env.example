# EasySynQ environment template (12-factor, D1). Copy to .env (0600) — never commit .env.
# install.sh generates the CHANGE_ME secrets at first run.

# --- core ---
EASYSYNQ_PROFILE=s                       # s | m  (l reserved, not MVP)
EASYSYNQ_ORG_TIMEZONE=UTC                # IANA tz; effective-date capture (R8)
# Tag for the images this repo builds (easysynq/api|web|keycloak). install.sh writes the repo's
# VERSION here so an air-gap target resolves the same refs the bundle loaded (C13); a hand-authored
# Compose run should set it to `scripts/app-images.sh --tag`.
EASYSYNQ_IMAGE_TAG=dev
LOG_LEVEL=INFO

# --- browser edge (production installer fills these; compose.dev.yml supplies localhost defaults) ---
# Production uses TWO HTTPS origins: the app/Keycloak site on 443 and MinIO on 9443. The latter is
# deliberately separate because presigned S3 requests cannot be routed through the SPA catch-all.
SITE_ADDRESS=
MINIO_SITE_ADDRESS=
CADDY_TLS_DIRECTIVE=                    # empty = ACME; "tls internal" = private/LAN Caddy CA
KEYCLOAK_HOSTNAME=
# Default-off edge guard for an operator-directed incompatible rollback. Set to 1 only while every
# write-capable api/worker/beat process is held back on the older application version.
EASYSYNQ_COMPATIBILITY_READ_ONLY=0

# --- database (PostgreSQL 16) — ROLE SEPARATION (S6, AC#6a) ---
POSTGRES_USER=easysynq
POSTGRES_PASSWORD=CHANGE_ME              # generated by install.sh
POSTGRES_DB=easysynq
# api/worker/beat connect as the NON-OWNER easysynq_app role (INSERT/SELECT-only on audit_event +
# signature_event, so the append-only trail is structurally enforced). Alembic (the migrate
# service) connects as the OWNER (POSTGRES_USER) so the 0010 migration can CREATE ROLE + GRANT.
DATABASE_URL=postgresql+psycopg://easysynq_app:CHANGE_ME_APP@postgres:5432/easysynq
DATABASE_URL_SYNC=postgresql+psycopg://easysynq:CHANGE_ME@postgres:5432/easysynq  # alembic = owner
# The chain-linker connects as a dedicated role with column-scoped UPDATE on the audit hash cols.
AUDIT_LINKER_DATABASE_URL=postgresql+psycopg://easysynq_linker:CHANGE_ME_LINKER@postgres:5432/easysynq
# Passwords the 0010 migration uses to CREATE the app + linker roles (must match the DSNs above).
APP_DB_PASSWORD=CHANGE_ME_APP
LINKER_DB_PASSWORD=CHANGE_ME_LINKER

# --- redis (broker / cache / locks / rate-limit / permissions-epoch) ---
REDIS_URL=redis://redis:6379/0

# --- object store (S3 API via boto3 — swap-clean to AWS S3 / Azure per D2/D4) ---
S3_ENDPOINT=http://minio:9000
# Browser-facing S3 host for presigned upload/download URLs: the SPA uploads/downloads controlled
# bytes DIRECTLY to the object store, and this value ALSO drives the SPA CSP connect-src (Caddy reads
# it), so it must equal the object-store origin the BROWSER actually reaches. Presigned URLs are
# SIGNED against this host (SigV4 signs the host) — never rewrite it post-signing.
# Blank is fail-closed for the template. compose.dev.yml supplies http://localhost:9000 and binds
# it to loopback only; install.sh writes the dedicated https://<host>:9443 production origin.
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET_DOCUMENTS=documents
S3_BUCKET_RENDITIONS=renditions
S3_BUCKET_RECORDS=records                # created in MVP; record capture is v1
S3_BUCKET_STAGING=staging
S3_BUCKET_RESTORE_SCRATCH=restore-scratch # S8b2: plain (non-WORM) scratch bucket for the restore drill
S3_BUCKET_IMPORT_STAGING=import-staging   # S-ing-1: plain (non-WORM) staging for imported source bytes
# The bucket object-lock mode (D-7: GOVERNANCE | COMPLIANCE) is NOT an env knob — the operator
# chooses it in the setup wizard's Storage step and it is stored per-org in storage_config.
WORM_RETENTION=30d                        # MinIO default retention for locked buckets (mc duration)

# --- S-ing-1 ingestion (doc 09, UJ-2): point IMPORT_SOURCE_PATH at the existing QMS file tree to
# import (a host dir). The worker mounts it READ-ONLY at IMPORT_SOURCE_ROOT (NG3); a run's source_root
# must resolve WITHIN that root (path-traversal/symlink-escape are rejected). Compose resolves
# relative bind sources from infra/compose, not from this file; ../../.import-source is therefore
# the repository-root default. Prefer an absolute host path when pointing at a real source tree. ---
IMPORT_SOURCE_PATH=../../.import-source
IMPORT_SOURCE_ROOT=/srv/import/source

# --- S-ing-2 ingestion extract + classify (doc 09 §5-6): the worker extracts text/metadata + OCRs
# scanned PDFs/images via the Apache Tika `-full` sidecar (HTTP, fully local). OCR is gated per-run by
# the create body's `ocr_enabled`; IMPORT_OCR_LANGUAGE is the Tesseract default. ---
TIKA_URL=http://tika:9998
IMPORT_OCR_LANGUAGE=eng

# --- S6 off-host audit-checkpoint sink (R13/D-8): a separate object-lock bucket reached with
# DISTINCT, write-only credentials held apart from the vault root (custody separation). Point this
# at a genuinely off-host/external endpoint before claiming tamper-evidence (the soft-gate stays
# false otherwise). minio-init.sh provisions the bucket + the scoped audit-sink user in dev.
S3_BUCKET_AUDIT_CHECKPOINTS=audit-checkpoints
AUDIT_SINK_ACCESS_KEY=audit-sink
AUDIT_SINK_SECRET_KEY=CHANGE_ME_AUDIT_SINK
# SEPARATE read-only creds for the INDEPENDENT off-host checkpoint verifier (doc 12 §4.4). The
# write-only sink cred above has no GetObject, so the read-back witness must be a distinct principal
# (minio-init.sh provisions the scoped audit-sink-read user in dev).
AUDIT_SINK_READ_ACCESS_KEY=audit-sink-read
AUDIT_SINK_READ_SECRET_KEY=CHANGE_ME_AUDIT_SINK_READ

# --- auth (Keycloak; API is an OAuth2 resource server) ---
OIDC_ISSUER=https://auth.example/realms/easysynq
OIDC_AUDIENCE=easysynq-api
OIDC_JWKS_URL=https://auth.example/realms/easysynq/protocol/openid-connect/certs
# Optional internal OIDC discovery URL for the first-run auth gate (G-D). Set this ONLY when the
# browser-facing OIDC_ISSUER is reverse-proxied and NOT reachable from the API container (e.g. a
# localhost/hostname dev issuer); the gate then probes the realm via this internal URL and skips the
# strict issuer-match. Leave empty when OIDC_ISSUER is directly reachable from the API host (prod).
# Dev (localhost) example:
#   OIDC_DISCOVERY_URL=http://keycloak:8080/realms/easysynq/.well-known/openid-configuration
OIDC_DISCOVERY_URL=

# --- S11 Keycloak realm export (the worker reaches the Admin REST API on the INTERNAL network to
# bundle the live realm into the backup; a Keycloak outage degrades the realm leg to "absent",
# never failing the backup). KEYCLOAK_ADMIN_USER/PASSWORD also seed the Keycloak admin account. ---
KEYCLOAK_ADMIN_URL=http://keycloak:8080
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME         # generated by install.sh
# Optional active database containing Keycloak's durable `keycloak` schema. Blank follows
# POSTGRES_DB; a future supported recovery cutover would set this together with the application DSNs.
# The current restore CLI's scratch verification target is not cutover-ready.
KEYCLOAK_DB_NAME=
# Dedicated PostgreSQL role password for Keycloak's durable schema.
KEYCLOAK_DB_PASSWORD=CHANGE_ME             # generated by install.sh

# --- renderer (Gotenberg) ---
GOTENBERG_URL=http://renderer:3000

# --- read-only filesystem mirror (worker-writable, user-RO; R11) ---
MIRROR_PATH=/var/lib/easysynq/qms-mirror

# --- S8b2 backup: default durable-archive destination (a mounted volume / NFS path). The per-org
# backup_policy.destination overrides. The restore-test drill + pg_dump run as the OWNER role, so
# the worker must see DATABASE_URL_SYNC (the owner DSN, set above for Alembic). ---
BACKUP_PATH=/var/lib/easysynq/backups

# --- secrets sealed by the app master KEK (never the plaintext DEKs) ---
APP_MASTER_KEK=CHANGE_ME                 # generated by install.sh, file 0600
BACKUP_ENCRYPTION_KEY=CHANGE_ME

# --- audit-checkpoint signing key (MVP scope; distinct from deferred Part-11 crypto) ---
AUDIT_CHECKPOINT_SIGNING_KEY_PATH=/run/secrets/audit_ckpt_key
# The PUBLIC half (exported by the beat anchor on first use) used to VERIFY checkpoint signatures
# (doc 12 §4.4). Lets the api/CLI/off-host verifier attest a checkpoint WITHOUT the beat-only signing
# secret — the detection control that exposes a DB-owner chain rewrite (the owner can't forge a sig).
AUDIT_CHECKPOINT_PUBLIC_KEY_PATH=/run/secrets/audit_ckpt_pub

# --- S7c verify-token signing key (shared api+worker via the `secrets` volume) + public origin ---
# The worker mints the controlled-copy verify token; the api verifies it on the public /verify page,
# so they must share this key. PUBLIC_BASE_URL is the browser-reachable origin the footer QR points
# at; APP_BASE_URL is the same origin used by notification deep links.
VERIFY_TOKEN_SIGNING_KEY_PATH=/run/secrets/verify_token_key
PUBLIC_BASE_URL=
APP_BASE_URL=

# --- SMTP transport (email is best-effort in MVP) ---
# LEFT EMPTY ON PURPOSE. An empty SMTP_HOST is the app's "no deliverable transport" state: the
# notification drain suppresses cleanly instead of queueing mail at a host that will never answer.
# `mailpit` is a DEV-PROFILE-ONLY container, so defaulting to it made every production install
# generated from this template aim its mail — and its operator alarms — at a service that is not
# running (audit U36). Uncomment the mailpit line for local development, or point these at the
# organization's own relay.
SMTP_HOST=
SMTP_PORT=1025
# dev: docker compose --profile dev up  →  SMTP_HOST=mailpit

# --- Batch 11: operator alarms for backup + audit-integrity failures --------------------------
# The OUT-OF-BAND channel. Everything else in the notification system needs PostgreSQL to resolve
# recipients, render a template and queue an email — which is exactly what is unavailable in the
# failure mode that matters most (the database itself is down, so the nightly backup cannot even
# read backup_policy). These channels need no database at all.
# Comma-separated subset of {syslog, smtp, webhook}. Empty (the default) = no out-of-band channel;
# alarms still reach the in-app notification path whenever the DB is up, and always the container
# log. Set at least one on a real install.
OPS_ALERT_CHANNELS=
# smtp: a fixed operator mailbox over the SMTP_* relay above, with no recipient lookup.
OPS_ALERT_SMTP_TO=
# webhook: an off-host receiver the org controls (POST application/json). Under D1 this carries
# operational metadata only — never document or record content.
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_WEBHOOK_TOKEN=
# syslog: a unix socket path, or host:port for a UDP collector. Empty ⇒ the channel is inert.
# ⚠ NOT defaulted to /dev/log on purpose. The worker/beat containers are python:3.12-slim-bookworm
# with no syslog daemon, and the shipped Compose services do not bind-mount the host socket — so
# /dev/log would look configured and reliably fail. Pick one:
#   (a) a collector reachable from the container, e.g. OPS_ALERT_SYSLOG_ADDRESS=syslog.internal:514
#   (b) the host's own journal — bind-mount the socket into BOTH worker and beat (they run the
#       nightly jobs) via a compose override, then set /dev/log here:
#         services: { worker: { volumes: ["/dev/log:/dev/log"] },
#                     beat:   { volumes: ["/dev/log:/dev/log"] } }
#       Linux hosts with journald only — there is no host /dev/log under Docker Desktop.
# After changing this, fire a test alert and check the ops_alert.dispatched log line reads
# "sent" rather than "failed"/"skipped".
# ⚠ The unix-socket form reports a dead socket as "failed"; the host:port form is UDP and
# fire-and-forget, so a closed collector port still reports "sent". Read "sent" over UDP as
# "emitted", not "delivered", and pair it with a second channel where confirmation matters.
OPS_ALERT_SYSLOG_ADDRESS=
OPS_ALERT_TIMEOUT_SECONDS=10

# Declare that this install REQUIRES an off-host audit witness (R13). Held HERE, not in the
# database, because the row a privileged DB owner would delete to go dark IS audit_checkpoint_sink
# — an in-DB "a witness is required" flag would be deleted alongside it. With this true, a nightly
# verify that finds no enabled off-host sink raises integrity.alarm instead of quietly deferring to
# the soft-gate. Leave false until a witness is actually configured, or every night alarms.
AUDIT_WITNESS_REQUIRED=false
# Grace window before a sink that is enabled but has NEVER anchored is treated as a dead witness.
AUDIT_WITNESS_GRACE_HOURS=24
