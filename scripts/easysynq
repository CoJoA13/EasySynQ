#!/usr/bin/env bash
# EasySynQ admin CLI (host-side). Dispatches to backup, restore, mirror, integrity,
# upgrade, migration, setup, and break-glass administration commands.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd -P)"
ENV_FILE="$ROOT/.env"
BASE_COMPOSE_FILE="$ROOT/infra/compose/compose.yml"
COMPOSE=()

env_value() {
  local key="$1"
  grep -m1 -E "^${key}[[:space:]]*=" "$ENV_FILE" 2>/dev/null | cut -d= -f2- \
    | sed -E \
      "s/[[:space:]]+#.*$//; s/^[[:space:]]*//; s/[[:space:]]*$//; s/^\"(.*)\"$/\\1/; s/^'(.*)'$/\\1/" \
    || true
}

load_compose() {
  [ "${#COMPOSE[@]}" -eq 0 ] || return 0

  local project="${COMPOSE_PROJECT_NAME:-}"
  local config_output config_set config_file existing
  local seen base_found=0
  local -a config_sets=() config_files=()

  if [ -z "$project" ]; then
    project="$(env_value COMPOSE_PROJECT_NAME)"
  fi
  project="${project:-easysynq}"

  if ! config_output="$(
    docker ps \
      --filter "label=com.docker.compose.project=${project}" \
      --format '{{.Label "com.docker.compose.project.config_files"}}'
  )"; then
    echo "easysynq: could not inspect the running Compose deployment for project ${project}" >&2
    exit 1
  fi

  while IFS= read -r config_set; do
    [ -n "$config_set" ] || continue
    seen=0
    for existing in "${config_sets[@]}"; do
      if [ "$existing" = "$config_set" ]; then
        seen=1
        break
      fi
    done
    [ "$seen" -eq 1 ] || config_sets+=("$config_set")
  done <<< "$config_output"

  if [ "${#config_sets[@]}" -eq 0 ]; then
    echo "easysynq: no running Compose deployment found for project ${project}" >&2
    exit 1
  fi
  if [ "${#config_sets[@]}" -gt 1 ]; then
    echo "easysynq: running containers disagree on the Compose file set for project ${project}" >&2
    exit 1
  fi

  IFS=',' read -r -a config_files <<< "${config_sets[0]}"
  COMPOSE=(docker compose --env-file "$ENV_FILE")
  for config_file in "${config_files[@]}"; do
    if [ ! -f "$config_file" ] || [ ! -r "$config_file" ]; then
      echo "easysynq: active Compose file is unavailable: ${config_file}" >&2
      exit 1
    fi
    if [[ "$config_file" -ef "$BASE_COMPOSE_FILE" ]]; then
      base_found=1
    fi
    COMPOSE+=(-f "$config_file")
  done

  if [ "$base_found" -ne 1 ]; then
    echo "easysynq: running project ${project} does not belong to this EasySynQ checkout" >&2
    exit 1
  fi
}

compose_run() {
  load_compose
  "${COMPOSE[@]}" run --rm --no-deps "$@"
}

usage() {
  cat <<'EOF'
usage: easysynq <command>

  backup run        Write a checksummed, non-self-contained archive (pg_dump +
                    MinIO blob manifest; no object bytes).                 [S8b2]
  backup restore-test
                    Run the backup->restore-into-scratch drill + integrity triad
                    (gate G-C); persists PASS/FAIL.                      [S8b2]
  restore <file> --confirm [--audit-checkpoint-ack]
                    Restore integrity verification in a fresh scratch target;
                    depends on the source object store and is NOT cutover-ready.
                    Leaves an integrity verification target for inspection. [S11]
  restore --discard <scratch-db>
                    Tear down a previously left-standing verification target.
  mirror rebuild    Regenerate the read-only filesystem mirror from the vault. [S7]
  blob verify [--full] [--sample-size N]
                    D1 integrity re-hash of vault blobs against blob.sha256
                    (rolling sample by default; --full = the complete pass).
                    Preserve and investigate the exact source bytes; re-run
                    only after separately validated direct repair or a future
                    supported recovery.                                [S-drift-3]
  upgrade --confirm Non-self-contained pre-upgrade archive -> migrate ->
                    health-gate; not a DR safety net. Production eligibility
                    remains blocked pending recovery proof.                [S11]
  migrate           Run 'alembic upgrade head' inside the api image.
  grant-role <sub> ["Role"] [--org CODE] [--bound-scope JSON]
                    Break-glass: assign a seeded role (default "System
                    Administrator") to a Keycloak subject directly (bypasses the
                    wizard). Idempotent.                                     [S2]
  setup mint-bootstrap [--ttl-hours N]
                    Mint the one-time first-run bootstrap secret; open /setup without
                    signing in, create the administrator profile, copy the temporary
                    password, acknowledge the active credential generation, then
                    sign in and change the password.                         [S8a]
  setup release-administrator-blocker --subject <keycloak-subject> [--org CODE]
                    Host-only pre-operational recovery: remove only the named unrelated
                    System Administrator assignment. Record an independent
                    incident/change record.                              [ADR 5]
  seed-personas --author <sub> --approver <sub> --releaser <sub>
                    Dev fixture: SoD-correct Priya(author)/Ken(approver)/Mara
                    (releaser) grants for the full lifecycle. Idempotent.
                    (Use `just seed-personas` to also create the logins.)    [dev]
EOF
}

cmd="${1:-}"; shift || true
case "$cmd" in
  migrate)
    compose_run migrate
    ;;
  grant-role)
    sub="${1:-}"
    if [ -z "$sub" ]; then
      echo 'usage: easysynq grant-role <keycloak-subject> ["Role Name"] [--org CODE] [--bound-scope JSON]' >&2
      exit 2
    fi
    shift
    role="System Administrator"
    if [ $# -gt 0 ] && [[ "$1" != --* ]]; then
      role="$1"
      shift
    fi
    compose_run api uv run python -m easysynq_api.cli.grant_role \
      --subject "$sub" --role "$role" "$@"
    ;;
  seed-personas)
    # Dev fixture: SoD-correct author/approver/releaser grants (S-web-5 demo). `just seed-personas`
    # wraps this and also provisions the matching Keycloak logins. Idempotent.
    compose_run api uv run python -m easysynq_api.cli.seed_personas "$@"
    ;;
  setup)
    # First-run bootstrap (S8a): e.g. `easysynq setup mint-bootstrap [--ttl-hours 24]`.
    compose_run api uv run python -m easysynq_api.cli.setup "$@"
    ;;
  backup)
    # S8b2: durable backup (`backup run`) + the restore-into-scratch drill (`backup restore-test`,
    # gate G-C). Runs on the WORKER (it carries postgresql-client + the owner DATABASE_URL_SYNC).
    compose_run worker uv run python -m easysynq_api.cli.backup "$@"
    ;;
  restore)
    # S11 (R37): restore integrity verification in a scratch target (checkpoint-not-ahead +
    # restored-chain re-verify). PASS still depends on the configured source object store; the
    # flattened scratch copy is not cutover-ready and is retained only for inspection/discard.
    # Runs on the WORKER (OWNER DATABASE_URL_SYNC + postgresql-client).
    compose_run worker uv run python -m easysynq_api.cli.restore "$@"
    ;;
  upgrade)
    # S11: non-self-contained pre-upgrade archive -> Alembic -> readiness health-gate. The archive
    # has no object bytes and is not a disaster-recovery set. Runs on the WORKER.
    compose_run worker uv run python -m easysynq_api.cli.upgrade "$@"
    ;;
  mirror)
    # rebuild/sync/scan write the mirror tree in-process, and the api service mounts the mirror
    # volume READ-ONLY by design (only the worker UID writes it) — dispatching to api fails the
    # first mkdir with EROFS. Runs on the WORKER, like backup/restore/upgrade/blob.
    compose_run worker uv run python -m easysynq_api.cli.mirror "$@"
    ;;
  blob)
    # S-drift-3 (D1): rolling/--full blob integrity re-hash under LOCK_BLOB_VERIFY. Runs on the
    # WORKER (the same internal-read path the Beat task uses; exit 1 on a FAILED infra scan).
    compose_run worker uv run python -m easysynq_api.cli.blob "$@"
    ;;
  ""|-h|--help|help)
    usage
    ;;
  *)
    echo "unknown command: $cmd" >&2
    usage
    exit 2
    ;;
esac
