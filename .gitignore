# --- secrets / env (D1: no secrets in git) ---
.env
.env.*
!.env.example
*.key
*.pem
infra/compose/.env
**/secrets/

# --- generated code (regenerated from packages/contracts/openapi.yaml) ---
packages/contracts/dist/
apps/api/src/easysynq_api/_generated/
apps/web/src/api/_generated/

# --- python ---
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/

# --- node / web ---
node_modules/
apps/web/dist/
apps/web/.vite/
apps/web/.playwright-dist/
apps/web/playwright-report/
apps/web/test-results/
*.log
npm-debug.log*

# --- os / editor ---
.DS_Store
.idea/
.vscode/
*.swp

# --- runtime data (never committed) ---
infra/data/
qms-mirror/
backups/
# .import-source/ = the S-ing-1 worker :ro import mount (the org's source documents; D1 — never in git)
.import-source/
.claude/scheduled_tasks.lock
.claude/settings.local.json
.claude/workflows/

# --- brainstorming visual-companion artifacts ---
.superpowers/

# --- agent-isolated implementation worktrees ---
.worktrees/

# --- external audit evidence (R61) ---
# Audit runs capture screenshots and JSON from a LIVE authenticated instance: real hostnames, account
# names, org identifiers and network detail. scripts/check-no-site-data.sh is a mechanical text scan and
# CANNOT read a PNG, so it will report clean over a directory full of reconnaissance material. R61 says
# sanitize at write time because removal cannot undo publication. Keep audit output out of the repo.
audit-results/
