{
  "name": "easysynq-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:browser": "tsc -p tsconfig.browser.json --noEmit && vite build --config e2e/vite.config.ts",
    "preview": "vite preview",
    "preview:browser": "vite preview --config e2e/vite.config.ts --host 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "fmt": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:browser": "npm run build:browser && playwright test",
    "test:first-admin-live": "playwright test --config playwright.live.config.ts"
  },
  "dependencies": {
    "@mantine/core": "^7.13.0",
    "@mantine/hooks": "^7.13.0",
    "@tanstack/react-query": "^5.101.4",
    "oidc-client-ts": "^3.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "postcss": "^8.5.23",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
